  "narrative": {
    "northStar": "Fotocopia y tijera",
    "overview": "Cada pieza es un recorte pegado a mano sobre un pliego de papel prensa: letras cortadas de distinto cuerpo y ángulo, páginas con cinta, puntos de semitono y tintas riso fluorescentes. El color ocupa regiones enteras y una sola grilla rígida (P101, P102, P103) ordena el desorden.",
    "keyCharacteristics": [
      "Papel prensa claro como suelo; toner negro para el texto; tres tintas riso como rellenos de región.",
      "Letras recortadas con tres voces tipográficas mezcladas por palabra.",
      "Cada pieza con su propio ángulo; el movimiento solo ocurre si el visitante no pidió menos movimiento."
    ],
    "rules": [
      {
        "name": "The Ink-On-Region Rule",
        "body": "Las tintas riso rellenan regiones y se acompañan de texto en toner o en papel; nunca se usan como color de texto sobre papel.",
        "section": "colors"
      },
      {
        "name": "The Tonal Honesty Rule",
        "body": "Los puntos de semitono no cruzan texto corrido.",
        "section": "colors"
      },
      {
        "name": "The Mixed Cut Rule",
        "body": "Dentro de una línea de recortes se alternan al menos dos voces tipográficas y dos colores de fondo.",
        "section": "typography"
      },
      {
        "name": "The Code Is Code Rule",
        "body": "El monoespaciado solo aparece donde hay código real.",
        "section": "typography"
      },
      {
        "name": "The One Edge Rule",
        "body": "Una superficie declara su elevación una sola vez: borde o sombra, nunca ambos.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do rellenar regiones con rosa, azul o amarillo y poner el texto en toner o en papel según el contraste.",
      "Do darle a cada pieza su ángulo y a cada proyecto un tratamiento visual propio.",
      "Do mantener las direcciones P101–P103 como la única grilla rígida.",
      "Do envolver todo movimiento en prefers-reduced-motion: no-preference."
    ],
    "donts": [
      "Don't volver a una grilla de tarjetas iguales sobre fondo oscuro.",
      "Don't poner puntos de semitono detrás de texto corrido.",
      "Don't presentar el identicon de GitHub como una foto.",
      "Don't usar sombras de bloque duro ni apilar borde y sombra."
    ]
  }
