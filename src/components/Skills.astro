---
import { skills } from '../data/projects';
---

<section id="habilidades" class="skills" aria-labelledby="skills-title">
  <div class="wrap">
    <h2 id="skills-title" class="cut-title">Habilidades</h2>
    <ul class="labels">
      {skills.map((skill, i) => <li style={`--k:${i}`}>{skill}</li>)}
    </ul>
  </div>
</section>
