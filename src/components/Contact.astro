---
import { profile } from '../data/projects';
---

<section id="contacto" class="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <h2 id="contact-title" class="cut-title cut-title-yellow">Contacto</h2>
    <p class="contact-lead">¿Un proyecto, una pasantía o solo curiosidad? Escríbeme.</p>
    <p class="actions">
      <a class="btn btn-main" href={`mailto:${profile.email}`}>{profile.email}</a>
      <a class="btn ext" href={profile.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
      <a class="btn ext" href={profile.github} rel="noopener noreferrer" target="_blank">github.com/{profile.handle}</a>
    </p>
  </div>
</section>
