# Copia a terraform.tfvars (ignorado por git) SOLO para pruebas locales.
# En CI estos valores llegan como TF_VAR_* desde GitHub Secrets.
tenancy_ocid     = "ocid1.tenancy.oc1..xxxx"
user_ocid        = "ocid1.user.oc1..xxxx"
fingerprint      = "aa:bb:cc:..."
private_key      = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
region           = "us-ashburn-1"
compartment_ocid = "ocid1.compartment.oc1..xxxx"
ssh_public_key   = "ssh-ed25519 AAAA... usuario@equipo"

enable_cloudflare    = true
cloudflare_api_token = ""
cloudflare_zone_id   = ""
domain               = "portafolio.midominio.com"
